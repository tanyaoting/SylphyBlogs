---
import ThemeToggle from './ThemeToggle.astro';
import { navItems } from '../lib/nav';

const { siteTitle } = Astro.props as { siteTitle: string };
const path = Astro.url.pathname;

const isActive = (href: string) =>
  href === '/' ? path === '/' : path === href || path.startsWith(`${href}/`);
---

<header class="site-header">
  <div class="wrap">
    <a class="brand" href="/">{siteTitle}</a>

    <div class="header-actions">
      <ThemeToggle />
      <button
        class="nav-toggle"
        id="nav-toggle"
        type="button"
        aria-label="打开导航菜单"
        aria-controls="site-nav"
        aria-expanded="false"
      >
        <svg class="icon-menu" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" aria-hidden="true">
          <path d="M4 7h16M4 12h16M4 17h16" />
        </svg>
        <svg class="icon-close" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" aria-hidden="true">
          <path d="M6 6l12 12M18 6L6 18" />
        </svg>
      </button>
    </div>

    <nav class="site-nav" id="site-nav" aria-label="主导航">
      <ul>
        {
          navItems.map((item) => (
            <li>
              <a
                href={item.href}
                aria-current={isActive(item.href) ? 'page' : undefined}
              >
                {item.label}
              </a>
            </li>
          ))
        }
      </ul>
    </nav>
  </div>
</header>

<script>
  const toggle = document.getElementById('nav-toggle');
  const nav = document.getElementById('site-nav');

  function setOpen(open: boolean) {
    toggle?.setAttribute('aria-expanded', String(open));
    toggle?.setAttribute('aria-label', open ? '关闭导航菜单' : '打开导航菜单');
    nav?.classList.toggle('is-open', open);
  }

  toggle?.addEventListener('click', () => {
    setOpen(toggle.getAttribute('aria-expanded') !== 'true');
  });

  document.addEventListener('keydown', (event) => {
    if (event.key === 'Escape') setOpen(false);
  });

  nav?.addEventListener('click', (event) => {
    if (event.target instanceof Element && event.target.closest('a')) setOpen(false);
  });
</script>

<style>
  .site-header {
    border-bottom: 1px solid var(--border);
    position: relative;
    z-index: 20;
  }

  .site-header .wrap {
    display: flex;
    align-items: center;
    gap: 1rem;
    min-height: 4rem;
  }

  .brand {
    margin-right: auto;
    font-size: 1.0625rem;
    font-weight: 650;
    letter-spacing: -0.01em;
    color: var(--fg);
  }

  .brand:hover {
    text-decoration: none;
    color: var(--accent);
  }

  .header-actions {
    display: flex;
    align-items: center;
    gap: 0.5rem;
  }

  .nav-toggle {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 2.25rem;
    height: 2.25rem;
    padding: 0;
    border: 1px solid var(--border);
    border-radius: 999px;
    background: var(--bg-soft);
    color: var(--fg);
    cursor: pointer;
  }

  .nav-toggle:hover {
    border-color: var(--accent);
  }

  .nav-toggle svg {
    width: 1.125rem;
    height: 1.125rem;
  }

  .nav-toggle .icon-close,
  .nav-toggle[aria-expanded='true'] .icon-menu {
    display: none;
  }

  .nav-toggle[aria-expanded='true'] .icon-close {
    display: block;
  }

  /* 小屏：导航折叠为下拉面板 */
  .site-nav {
    display: none;
    position: absolute;
    top: 100%;
    left: 0;
    right: 0;
    background: var(--bg);
    border-bottom: 1px solid var(--border);
    box-shadow: 0 12px 24px -18px rgb(0 0 0 / 45%);
  }

  .site-nav.is-open {
    display: block;
  }

  .site-nav ul {
    list-style: none;
    margin: 0;
    padding: 0.5rem 1.25rem 1rem;
  }

  .site-nav a {
    display: block;
    padding: 0.5rem 0;
    color: var(--fg);
    font-size: 0.9375rem;
  }

  .site-nav a:hover {
    color: var(--accent);
    text-decoration: none;
  }

  .site-nav a[aria-current='page'] {
    color: var(--accent);
    font-weight: 600;
  }

  /* 宽屏：导航横向展开，汉堡按钮隐藏 */
  @media (min-width: 48em) {
    .nav-toggle {
      display: none;
    }

    .site-nav {
      order: 2;
      display: block;
      position: static;
      border: 0;
      background: none;
      box-shadow: none;
    }

    .header-actions {
      order: 3;
    }

    .site-nav ul {
      display: flex;
      align-items: center;
      gap: 1.25rem;
      padding: 0;
    }

    .site-nav a {
      padding: 0;
      color: var(--fg-muted);
      font-size: 0.9375rem;
    }

    .site-nav a[aria-current='page'] {
      color: var(--accent);
      font-weight: 600;
    }
  }
</style>
