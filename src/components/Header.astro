---
import ThemeToggle from './ThemeToggle.astro';
import { navItems } from '../lib/nav';

const { siteTitle } = Astro.props as { siteTitle: string };
const path = Astro.url.pathname;

const isActive = (href: string) =>
  href === '/' ? path === '/' : path === href || path.startsWith(`${href}/`);
---

<div class="header-spacer" aria-hidden="true"></div>
<header class="site-header" id="site-header">
  <div class="header-inner">
    <a class="brand" href="/">
      <img
        class="brand-logo"
        src="/images/logo.png"
        alt=""
        width="32"
        height="32"
        decoding="async"
      />
      <span class="brand-text">{siteTitle}</span>
    </a>

    <div class="header-actions">
      <ThemeToggle />
      <button
        class="nav-toggle"
        id="nav-toggle"
        type="button"
        aria-label="打开导航菜单"
        aria-controls="site-nav"
        aria-expanded="false"
      >
        <svg class="icon-menu" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" aria-hidden="true">
          <path d="M4 7h16M4 12h16M4 17h16" />
        </svg>
        <svg class="icon-close" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" aria-hidden="true">
          <path d="M6 6l12 12M18 6L6 18" />
        </svg>
      </button>
    </div>

    <nav class="site-nav" id="site-nav" aria-label="主导航">
      <ul>
        {
          navItems.map((item) => (
            <li>
              <a
                href={item.href}
                aria-current={isActive(item.href) ? 'page' : undefined}
              >
                {item.label}
              </a>
            </li>
          ))
        }
      </ul>
    </nav>
  </div>
</header>

<script>
  const header = document.getElementById('site-header');
  const toggle = document.getElementById('nav-toggle');
  const nav = document.getElementById('site-nav');

  function setOpen(open: boolean) {
    toggle?.setAttribute('aria-expanded', String(open));
    toggle?.setAttribute('aria-label', open ? '关闭导航菜单' : '打开导航菜单');
    nav?.classList.toggle('is-open', open);
  }

  toggle?.addEventListener('click', () => {
    setOpen(toggle.getAttribute('aria-expanded') !== 'true');
  });

  document.addEventListener('keydown', (event) => {
    if (event.key === 'Escape') setOpen(false);
  });

  nav?.addEventListener('click', (event) => {
    if (event.target instanceof Element && event.target.closest('a')) setOpen(false);
  });

  // 滚动：往下滚收起成紧凑条，往上滑恢复，顶部恢复原状
  const TOP_THRESHOLD = 12;
  const DELTA = 6;
  let lastY = window.scrollY;
  let ticking = false;

  function sync() {
    const y = Math.max(window.scrollY, 0);
    const delta = y - lastY;
    header?.toggleAttribute('data-scrolled', y > TOP_THRESHOLD);

    if (y <= TOP_THRESHOLD) {
      header?.removeAttribute('data-compact');
    } else if (delta > DELTA) {
      header?.setAttribute('data-compact', '');
    } else if (delta < -DELTA) {
      header?.removeAttribute('data-compact');
    }

    lastY = y;
    ticking = false;
  }

  window.addEventListener(
    'scroll',
    () => {
      if (!ticking) {
        ticking = true;
        requestAnimationFrame(sync);
      }
    },
    { passive: true },
  );

  sync();
</script>

<style>
  /* 固定定位的 header 不占文档流，用固定高度的占位块预留空间，
     这样 header 压缩时文档高度不变，滚动位置不会抖动 */
  .header-spacer {
    height: var(--header-height);
  }

  .site-header {
    position: fixed;
    top: 0;
    left: 0;
    right: 0;
    z-index: 40;
    border-bottom: 1px solid var(--border);
    background: var(--bg);
    background: color-mix(in oklab, var(--bg) 92%, transparent);
    backdrop-filter: blur(12px) saturate(150%);
    -webkit-backdrop-filter: blur(12px) saturate(150%);
    box-shadow: 0 1px 0 var(--border);
    transition:
      box-shadow 0.25s ease,
      background-color 0.25s ease;
  }

  .site-header[data-scrolled] {
    box-shadow:
      0 1px 0 var(--border),
      0 10px 30px -18px rgb(0 0 0 / 22%);
  }

  :global(html[data-theme='dark']) .site-header[data-scrolled] {
    box-shadow:
      0 1px 0 var(--border),
      0 10px 30px -14px rgb(0 0 0 / 65%);
  }

  .header-inner {
    display: flex;
    align-items: center;
    gap: 1rem;
    width: 100%;
    max-width: var(--header-measure);
    margin: 0 auto;
    padding: 0 2rem;
    min-height: var(--header-height);
    transition: min-height 0.28s cubic-bezier(0.32, 0.72, 0, 1);
  }

  .site-header[data-compact] .header-inner {
    min-height: var(--header-height-compact);
  }

  .brand {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    margin-right: auto;
    font-size: 1.0625rem;
    font-weight: 650;
    letter-spacing: -0.01em;
    color: var(--fg);
    transition:
      font-size 0.28s ease,
      color 0.15s ease;
  }

  .brand-logo {
    width: 2rem;
    height: 2rem;
    flex: none;
    display: block;
    border-radius: 50%;
    background: #fff;
    object-fit: cover;
    transition:
      width 0.28s ease,
      height 0.28s ease;
  }

  .site-header[data-compact] .brand {
    font-size: 0.9375rem;
  }

  .site-header[data-compact] .brand-logo {
    width: 1.625rem;
    height: 1.625rem;
  }

  .brand:hover {
    text-decoration: none;
    filter: brightness(1.12) saturate(1.1);
  }

  .header-actions {
    display: flex;
    align-items: center;
    gap: 0.5rem;
  }

  .nav-toggle {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 2.25rem;
    height: 2.25rem;
    padding: 0;
    border: 1px solid var(--border);
    border-radius: 999px;
    background: var(--bg-soft);
    color: var(--fg);
    cursor: pointer;
    transition: border-color 0.15s ease;
  }

  .nav-toggle:hover {
    border-color: var(--accent);
  }

  .nav-toggle svg {
    width: 1.125rem;
    height: 1.125rem;
  }

  .nav-toggle .icon-close,
  .nav-toggle[aria-expanded='true'] .icon-menu {
    display: none;
  }

  .nav-toggle[aria-expanded='true'] .icon-close {
    display: block;
  }

  /* 小屏：导航折叠为下拉面板 */
  .site-nav {
    display: none;
    position: absolute;
    top: 100%;
    left: 0;
    right: 0;
    background: var(--bg);
    border-bottom: 1px solid var(--border);
    box-shadow: 0 18px 32px -22px rgb(0 0 0 / 45%);
  }

  .site-nav.is-open {
    display: block;
  }

  .site-nav ul {
    list-style: none;
    margin: 0;
    padding: 0.5rem 1.25rem 1rem;
    display: flex;
    flex-direction: column;
    gap: 0.25rem;
  }

  .site-nav a {
    display: block;
    padding: 0.5rem 0.75rem;
    border-radius: 8px;
    color: var(--fg);
    font-size: 0.9375rem;
    transition:
      color 0.15s ease,
      background-color 0.15s ease;
  }

  .site-nav a:hover {
    color: var(--fg);
    background: var(--bg-soft);
    text-decoration: none;
  }

  .site-nav a[aria-current='page'] {
    color: var(--accent);
    background: color-mix(in oklab, var(--accent) 12%, transparent);
    font-weight: 600;
  }

  /* 宽屏：导航横向展开，汉堡按钮隐藏 */
  @media (min-width: 48em) {
    .nav-toggle {
      display: none;
    }

    .site-nav {
      order: 2;
      display: block;
      position: static;
      border: 0;
      background: none;
      box-shadow: none;
    }

    .header-actions {
      order: 3;
    }

    .site-nav ul {
      flex-direction: row;
      align-items: center;
      gap: 0.25rem;
      padding: 0;
    }

    .site-nav a {
      padding: 0.4375rem 0.875rem;
      border-radius: 999px;
      color: var(--fg-muted);
      font-size: 0.9375rem;
    }

    .site-nav a:hover {
      color: var(--fg);
      background: var(--bg-soft);
    }

    .site-nav a[aria-current='page'] {
      color: var(--accent);
      background: color-mix(in oklab, var(--accent) 12%, transparent);
      font-weight: 600;
    }

    .site-header[data-compact] .site-nav a {
      padding-top: 0.3125rem;
      padding-bottom: 0.3125rem;
      font-size: 0.875rem;
    }
  }
</style>
