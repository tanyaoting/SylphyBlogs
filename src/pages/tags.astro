---
import { getCollection } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import { formatDate, toISODate } from '../lib/date';

const posts = (await getCollection('blog', ({ data }) => !data.draft)).sort(
  (a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf(),
);

const tagMap = new Map<string, typeof posts>();
for (const post of posts) {
  for (const tag of post.data.tags) {
    const bucket = tagMap.get(tag) ?? [];
    bucket.push(post);
    tagMap.set(tag, bucket);
  }
}

const tags = [...tagMap.entries()].sort(
  (a, b) => b[1].length - a[1].length || a[0].localeCompare(b[0], 'zh-CN'),
);
---

<BaseLayout title="标签" description="按标签浏览文章。">
  <h1 class="page-title">标签</h1>
  <p class="page-intro">共 {tags.length} 个标签。</p>

  <ul class="tag-cloud">
    {
      tags.map(([tag, items]) => (
        <li>
          <a href={`#tag-${tag}`}>
            {tag}
            <span class="count">{items.length}</span>
          </a>
        </li>
      ))
    }
  </ul>

  {
    tags.map(([tag, items]) => (
      <section class="tag-group" id={`tag-${tag}`}>
        <h2>{tag}</h2>
        <ul class="tag-posts">
          {items.map((post) => (
            <li>
              <a href={`/blog/${post.id}/`}>{post.data.title}</a>
              <time datetime={toISODate(post.data.pubDate)}>
                {formatDate(post.data.pubDate)}
              </time>
            </li>
          ))}
        </ul>
      </section>
    ))
  }
</BaseLayout>

<style>
  .tag-cloud {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
    list-style: none;
    margin: 0 0 3rem;
    padding: 0;
  }

  .tag-cloud a {
    display: inline-flex;
    align-items: center;
    gap: 0.375rem;
    padding: 0.25rem 0.75rem;
    border: 1px solid var(--border);
    border-radius: 999px;
    background: var(--bg-soft);
    color: var(--fg);
    font-size: 0.875rem;
  }

  .tag-cloud a:hover {
    border-color: var(--accent);
    color: var(--accent);
    text-decoration: none;
  }

  .count {
    color: var(--fg-muted);
    font-size: 0.75rem;
    font-variant-numeric: tabular-nums;
  }

  .tag-group {
    scroll-margin-top: 5rem;
    margin-bottom: 2.5rem;
  }

  .tag-group h2 {
    margin: 0 0 0.5rem;
    font-size: 1rem;
    font-weight: 600;
    letter-spacing: -0.01em;
  }

  .tag-posts {
    list-style: none;
    margin: 0;
    padding: 0;
    border-top: 1px solid var(--border);
  }

  .tag-posts li {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: 1rem;
    padding: 0.75rem 0;
    border-bottom: 1px solid var(--border);
  }

  .tag-posts a {
    color: var(--fg);
  }

  .tag-posts a:hover {
    color: var(--accent);
    text-decoration: none;
  }

  .tag-posts time {
    flex: none;
    color: var(--fg-muted);
    font-size: 0.8125rem;
    font-variant-numeric: tabular-nums;
  }
</style>
