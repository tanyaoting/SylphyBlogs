---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout title="SylphyBlogs" description="记录技术、阅读与思考。">
  <section class="hero">
    <p class="eyebrow">Welcome</p>
    <h1>你好，我是 Sylphy</h1>
    <p class="lead">
      这里记录技术笔记、阅读摘录，以及一些没想清楚的碎片。文章写在本地 Markdown
      里，构建时生成纯静态页面。
    </p>
    <div class="cta">
      <a class="btn btn-primary" href="/blog">进入博客</a>
      <a class="btn" href="/about">关于我</a>
    </div>
  </section>
</BaseLayout>

<style>
  .hero {
    max-width: 38rem;
    padding: 4rem 0 2rem;
  }

  .eyebrow {
    margin: 0 0 1rem;
    color: var(--accent);
    font-size: 0.75rem;
    font-weight: 600;
    letter-spacing: 0.14em;
    text-transform: uppercase;
  }

  .hero h1 {
    margin: 0 0 1rem;
    font-size: clamp(2rem, 4vw, 2.75rem);
    line-height: 1.25;
    letter-spacing: -0.03em;
  }

  .lead {
    margin: 0 0 2.5rem;
    color: var(--fg-muted);
    font-size: 1.0625rem;
  }

  .cta {
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem;
  }

  .btn {
    display: inline-flex;
    align-items: center;
    padding: 0.625rem 1.25rem;
    border: 1px solid var(--border);
    border-radius: 999px;
    background: var(--bg-soft);
    color: var(--fg);
    font-size: 0.9375rem;
    transition:
      border-color 0.15s ease,
      color 0.15s ease;
  }

  .btn:hover {
    border-color: var(--accent);
    color: var(--accent);
    text-decoration: none;
  }

  .btn-primary {
    border-color: var(--accent);
    background: var(--accent);
    color: var(--bg);
  }

  .btn-primary:hover {
    background: var(--accent);
    color: var(--bg);
    opacity: 0.88;
  }
</style>
